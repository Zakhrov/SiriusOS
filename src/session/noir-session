#!/bin/sh
# Noir Desktop Environment X session: the window manager, then the shell.
# Started by a display manager through noir.desktop, or from ~/.xinitrc.
#
# Settings come from /etc/noir/session.conf and ~/.config/noir/session.conf
# (plain shell, later wins):
#   NOIR_WM_ARGS     arguments for NoirWM     (default: none; --no-compositor
#                    turns the Vulkan compositor off)
#   NOIR_SHELL_ARGS  arguments for NoirShell  (default: none)

# The shell needs a session bus for notifications.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

export XDG_CURRENT_DESKTOP=Noir
export XDG_SESSION_DESKTOP=noir
export XDG_SESSION_TYPE=x11

NOIR_WM_ARGS=
NOIR_SHELL_ARGS=
for conf in /etc/noir/session.conf "${XDG_CONFIG_HOME:-$HOME/.config}/noir/session.conf"; do
    [ -r "$conf" ] && . "$conf"
done

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/noir"
mkdir -p "$log_dir"
# Keep Qt's messages in the log file instead of the journal.
export QT_FORCE_STDERR_LOGGING=1

# shellcheck disable=SC2086
NoirWM $NOIR_WM_ARGS >"$log_dir/wm.log" 2>&1 &
wm=$!

# Let the window manager take the root window before the shell maps its
# surfaces, so they are stacked and given their struts from the start.
if command -v xprop >/dev/null 2>&1; then
    tries=0
    while [ $tries -lt 50 ] && kill -0 $wm 2>/dev/null \
          && ! xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id'; do
        sleep 0.1
        tries=$((tries + 1))
    done
fi

# The session lasts as long as the shell does.
# shellcheck disable=SC2086
NoirShell $NOIR_SHELL_ARGS >"$log_dir/shell.log" 2>&1
status=$?

kill $wm 2>/dev/null
exit $status
